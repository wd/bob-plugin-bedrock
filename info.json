{
  "identifier": "com.dong.bob-plugin-bedrock",
  "version": "1.0.0",
  "category": "translate",
  "name": "Bedrock Translator",
  "summary": "Translate using AWS Bedrock Claude models via local server",
  "icon": "",
  "author": "dong",
  "homepage": "https://github.com/dong/bob-plugin-bedrock",
  "appcast": "",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "serverUrl",
      "type": "text",
      "title": "Server URL",
      "defaultValue": "http://localhost:18081",
      "desc": "Local bridge server URL"
    },
    {
      "identifier": "model",
      "type": "menu",
      "title": "Model",
      "defaultValue": "us.anthropic.claude-3-5-haiku-20241022-v1:0",
      "menuValues": [
        {
          "title": "Claude 3.5 Haiku (Fast)",
          "value": "us.anthropic.claude-3-5-haiku-20241022-v1:0"
        },
        {
          "title": "Claude Haiku 4.5 (Fast, Newer)",
          "value": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        },
        {
          "title": "Claude Sonnet 4 (Balanced)",
          "value": "us.anthropic.claude-sonnet-4-20250514-v1:0"
        },
        {
          "title": "Claude Sonnet 4.5 (High Quality)",
          "value": "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
        },
        {
          "title": "Claude Opus 4.6 (Most Capable)",
          "value": "us.anthropic.claude-opus-4-6-v1"
        }
      ],
      "desc": "Claude model to use for translation"
    },
    {
      "identifier": "prompt",
      "type": "text",
      "title": "Custom Prompt",
      "defaultValue": "",
      "textConfig": {
        "type": "visible",
        "height": 200,
        "placeholderText": "Leave empty to use default prompt"
      },
      "desc": "Custom translation prompt. Variables: {from}(source language), {to}(target language), {text}(original text)"
    }
  ]
}
